# Copy this file to .env and fill in your values.
# The backend will read this automatically via dotenv.

# Server port (default: 5000)
PORT=5000

# Allowed CORS origin for your frontend (dev default shown)
ALLOWED_ORIGIN=http://localhost:5173

# Email for contact form recipient (wire into nodemailer or similar)
CONTACT_TO=your-email@example.com

# SMTP configuration (optional — needed only if you add email delivery)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
